;;; Commentary:

;; Load this file in a GUI Emacs session and run:
;;
;;   M-x mac-performance-run-benchmarks
;;
;; For unattended GUI runs from startup, schedule the work after the initial
;; frame setup and write results to a file:
;;
;;   emacs -Q -l test/src/mac-performance-benchmark.el \
;;     --eval '(mac-performance-run-benchmarks-and-exit "/tmp/mac-bench.el")'
;;
;; The harness stresses mac-port-specific redisplay paths and samples optional
;; counters exposed by the mac port, including Metal rendering, Metal clip
;; overdraw, and AppKit select latency counters when those functions exist.

;;; Code:

(require 'cl-lib)
(require 'jsonrpc nil t)

(defgroup mac-performance-benchmark nil
  "macOS GUI performance benchmarks."
  :group 'internal)

(defcustom mac-performance-benchmark-iterations 120
  "Default iteration count for each mac performance scenario."
  :type 'integer)

(defcustom mac-performance-benchmark-source-lines 6000
  "Number of source-like lines generated by the scrolling scenario."
  :type 'integer)

(defcustom mac-performance-benchmark-coding-lines 1200
  "Number of source-like lines generated by coding responsiveness scenarios."
  :type 'integer)

(defcustom mac-performance-benchmark-startup-delay 1.0
  "Seconds to wait before starting unattended GUI benchmark runs.
The delay lets startup finish frame creation before the harness forces
redisplay."
  :type 'number)

(defvar mac-performance--modeline-tick 0)
(defvar mac-performance--collect-latency nil)
(defvar mac-performance--latency-samples nil)
(defvar mac-performance--command-loop-command-start nil)

(defconst mac-performance--counter-functions
  '(mac-gc-clip-stats
    mac-metal-render-stats
    mac-metal-clip-overdraw-stats
    mac-select-latency-stats)
  "Optional mac-port counter functions sampled by the benchmark harness.")

(defun mac-performance--counter-snapshot (&optional reset)
  "Return an alist of available mac counter snapshots.
If RESET is non-nil, reset each counter while reading it."
  (delq nil
        (mapcar (lambda (fn)
                  (when (fboundp fn)
                    (cons fn (funcall fn reset))))
                mac-performance--counter-functions)))

(defun mac-performance--iteration-count (iterations)
  "Return benchmark iteration count from ITERATIONS or default settings."
  (cond ((numberp iterations) iterations)
        ((consp iterations) (prefix-numeric-value iterations))
        (t mac-performance-benchmark-iterations)))

(defun mac-performance--record-latency (name seconds)
  "Record latency sample SECONDS under NAME when latency collection is active."
  (when mac-performance--collect-latency
    (let ((cell (assq name mac-performance--latency-samples)))
      (if cell
          (setcdr cell (cons seconds (cdr cell)))
        (push (list name seconds) mac-performance--latency-samples)))))

(defun mac-performance--time-latency (name function)
  "Call FUNCTION and record its elapsed time under latency bucket NAME."
  (if (not mac-performance--collect-latency)
      (funcall function)
    (let ((start (float-time)))
      (unwind-protect
          (funcall function)
        (mac-performance--record-latency name (- (float-time) start))))))

(defun mac-performance--command-loop-pre-command ()
  "Record the start time for one command-loop command."
  (setq mac-performance--command-loop-command-start (float-time)))

(defun mac-performance--command-loop-post-command ()
  "Record elapsed time for one command-loop command."
  (when mac-performance--command-loop-command-start
    (mac-performance--record-latency
     'command-loop-command
     (- (float-time) mac-performance--command-loop-command-start))
    (setq mac-performance--command-loop-command-start nil)))

(defun mac-performance--execute-kbd-macro-with-command-latency (macro)
  "Execute keyboard MACRO while recording command-loop latency."
  (let ((pre-command-hook
         (cons #'mac-performance--command-loop-pre-command
               pre-command-hook))
        (post-command-hook
         (cons #'mac-performance--command-loop-post-command
               post-command-hook))
        mac-performance--command-loop-command-start)
    (mac-performance--time-latency
     'command-loop-macro
     (lambda ()
       (execute-kbd-macro macro)))))

(defun mac-performance--latency-percentile (sorted-samples percentile)
  "Return nearest-rank PERCENTILE from SORTED-SAMPLES."
  (let* ((count (length sorted-samples))
         (index (max 0 (min (1- count)
                            (1- (ceiling (* percentile count)))))))
    (nth index sorted-samples)))

(defun mac-performance--latency-summary (samples)
  "Return summary statistics for latency SAMPLES.
SAMPLES is an alist whose entries are shaped like (NAME SAMPLE...)."
  (let (summary)
    (dolist (entry (sort (cl-remove-if-not #'cdr (copy-sequence samples))
                         (lambda (a b)
                           (string< (symbol-name (car a))
                                    (symbol-name (car b))))))
      (let* ((name (car entry))
             (sorted (sort (copy-sequence (cdr entry)) #'<))
             (count (length sorted))
             (total (apply #'+ sorted)))
        (push (cons name
                    (list :count count
                          :total-seconds total
                          :average-seconds (/ total count)
                          :p50-seconds (mac-performance--latency-percentile
                                         sorted 0.50)
                          :p95-seconds (mac-performance--latency-percentile
                                         sorted 0.95)
                          :max-seconds (car (last sorted))))
              summary)))
    (nreverse summary)))

(defun mac-performance--record-progress (progress-file event)
  "Append EVENT to PROGRESS-FILE when PROGRESS-FILE is non-nil."
  (when progress-file
    (with-temp-buffer
      (let ((print-length nil)
            (print-level nil)
            (print-circle t))
        (prin1 event (current-buffer))
        (terpri (current-buffer)))
      (write-region (point-min) (point-max) progress-file t nil))))

(defun mac-performance--write-results-file (output-file object)
  "Write OBJECT to OUTPUT-FILE as a readable Lisp expression."
  (let ((print-length nil)
        (print-level nil)
        (print-circle t))
    (with-temp-file output-file
      (prin1 object (current-buffer))
      (terpri (current-buffer)))))

(defun mac-performance--redisplay ()
  "Force redisplay for GUI benchmark scenarios."
  (mac-performance--time-latency
   'redisplay
   (lambda ()
     (redisplay 'force))))

(defun mac-performance--scroll-window (iterations)
  "Scroll the selected window for ITERATIONS steps."
  (dotimes (i iterations)
    (mac-performance--time-latency
     'scroll-command
     (lambda ()
       (condition-case nil
           (scroll-up-command)
         (end-of-buffer
          (goto-char (point-min))))))
    (when (zerop (mod i 8))
      (mac-performance--redisplay))))

(defun mac-performance--run-scenario (name setup exercise iterations)
  "Run benchmark scenario NAME with SETUP and EXERCISE.
ITERATIONS is passed to EXERCISE.  Return a plist with timing and counters."
  (let ((buffer (get-buffer-create (format " *mac-performance-%s*" name)))
        (old-buffer (current-buffer))
        (old-gcs gcs-done)
        start seconds counters latency)
    (unwind-protect
        (progn
          (switch-to-buffer buffer)
          (let ((inhibit-read-only t))
            (erase-buffer))
          (funcall setup)
          (goto-char (point-min))
          (mac-performance--redisplay)
          (garbage-collect)
          (mac-performance--counter-snapshot t)
          (setq old-gcs gcs-done)
          (let ((mac-performance--collect-latency t)
                mac-performance--latency-samples)
            (setq start (float-time))
            (funcall exercise iterations)
            (mac-performance--redisplay)
            (setq seconds (- (float-time) start))
            (setq latency
                  (mac-performance--latency-summary
                   mac-performance--latency-samples)))
          (setq counters (mac-performance--counter-snapshot))
          (list :name name
                :seconds seconds
                :gc-count (- gcs-done old-gcs)
                :latency latency
                :counters counters))
      (when (buffer-live-p buffer)
        (kill-buffer buffer))
      (when (buffer-live-p old-buffer)
        (switch-to-buffer old-buffer)))))

(defun mac-performance--insert-source-lines (lines)
  "Insert LINES source-like lines into the current buffer."
  (dotimes (i lines)
    (insert (format "(defun mac-bench-%05d (x) (+ x %d)) ; render me\n"
                    i (mod i 97)))))

(defun mac-performance--scenario-scroll-source (iterations)
  "Run the large source scrolling scenario for ITERATIONS."
  (mac-performance--run-scenario
   "scroll-source"
   (lambda ()
     (emacs-lisp-mode)
     (mac-performance--insert-source-lines
      mac-performance-benchmark-source-lines)
     (font-lock-ensure))
   #'mac-performance--scroll-window
   iterations))

(defun mac-performance--scenario-typing-source (iterations)
  "Run source-like edit latency scenario for ITERATIONS."
  (mac-performance--run-scenario
   "typing-source"
   (lambda ()
     (emacs-lisp-mode)
     (mac-performance--insert-source-lines
      mac-performance-benchmark-source-lines)
     (font-lock-ensure))
   (lambda (n)
     (let ((line-count (max 1 (1- mac-performance-benchmark-source-lines))))
       (dotimes (i n)
         (goto-char (point-min))
         (forward-line (mod (* i 17) line-count))
         (end-of-line)
         (mac-performance--time-latency
          'typing-command
          (lambda ()
            (insert "x")
            (delete-region (1- (point)) (point))))
         (when (zerop (mod i 4))
           (mac-performance--redisplay)))))
   iterations))

(defun mac-performance--scenario-command-loop-input (iterations)
  "Run keyboard-macro command-loop input scenario for ITERATIONS."
  (mac-performance--run-scenario
   "command-loop-input"
   (lambda ()
     (emacs-lisp-mode)
     (mac-performance--insert-source-lines
      mac-performance-benchmark-source-lines)
     (font-lock-ensure))
   (lambda (n)
     (goto-char (point-min))
     (mac-performance--execute-kbd-macro-with-command-latency
      (make-vector n ?a)))
   iterations))

(defun mac-performance--process-output-command ()
  "Return a command list that echoes stdin to stdout."
  (list (or (executable-find "cat") "cat")))

(defun mac-performance--scenario-process-output (iterations)
  "Run asynchronous process-output latency scenario for ITERATIONS."
  (mac-performance--run-scenario
   "process-output"
   (lambda ()
     (fundamental-mode))
   (lambda (n)
     (let* ((chunk
             "mac-bench process output line with enough text to decode\n")
            (proc (make-process
                   :name "mac-performance-process-output"
                   :buffer (current-buffer)
                   :command (mac-performance--process-output-command)
                   :connection-type 'pipe
                   :noquery t)))
       (unwind-protect
           (progn
             (dotimes (i n)
               (mac-performance--time-latency
                'process-send
                (lambda ()
                  (process-send-string proc chunk)))
               (when (zerop (mod i 8))
                 (mac-performance--time-latency
                  'process-output-drain
                  (lambda ()
                    (accept-process-output proc 0.02 nil t))))
               (when (zerop (mod i 16))
                 (mac-performance--redisplay)))
             (process-send-eof proc)
             (let ((waits 0))
               (while (and (process-live-p proc) (< waits 200))
                 (setq waits (1+ waits))
                 (mac-performance--time-latency
                  'process-output-drain
                  (lambda ()
                    (accept-process-output proc 0.05 nil t)))))
             (while (mac-performance--time-latency
                     'process-output-drain
                     (lambda ()
                       (accept-process-output proc 0 nil t)))))
         (when (process-live-p proc)
           (delete-process proc)))))
   iterations))

(defun mac-performance--mixed-script-line ()
  "Return a line containing mixed scripts without relying on literal Unicode."
  (concat "latin "
          (string #x03bb #x03c0 #x03c3) " "
          (string #x05d0 #x05d1 #x05d2) " "
          (string #x0645 #x0631 #x062d #x0628 #x0627) " "
          (string #x4e2d #x6587) "\n"))

(defun mac-performance--scenario-mixed-script (iterations)
  "Run the mixed-script redisplay scenario for ITERATIONS."
  (mac-performance--run-scenario
   "mixed-script"
   (lambda ()
     (setq-local bidi-display-reordering t)
     (dotimes (_ 3000)
       (insert (mac-performance--mixed-script-line))))
   (lambda (n)
     (dotimes (i n)
       (goto-char (point-min))
       (forward-line (mod (* i 17) 2800))
       (recenter)
       (when (zerop (mod i 6))
         (mac-performance--redisplay))))
   iterations))

(defun mac-performance--emoji-line ()
  "Return an emoji-heavy line without relying on literal Unicode."
  (concat "emoji "
          (string #x1f600 #x1f680 #x1f4a1 #x2728 #x1f9ea #x1f4bb)
          " text text text\n"))

(defun mac-performance--scenario-emoji (iterations)
  "Run the emoji-heavy redisplay scenario for ITERATIONS."
  (mac-performance--run-scenario
   "emoji"
   (lambda ()
     (dotimes (_ 2500)
       (insert (mac-performance--emoji-line))))
   #'mac-performance--scroll-window
   iterations))

(defun mac-performance--xbm-image ()
  "Return a small XBM image object, or nil if image creation fails."
  (when (image-type-available-p 'xbm)
    (create-image
     "#define mac_bench_width 16
#define mac_bench_height 16
static unsigned char mac_bench_bits[] = {
  0xff,0xff,0x81,0x81,0xbd,0xbd,0xa5,0xa5,
  0xa5,0xa5,0xbd,0xbd,0x81,0x81,0xff,0xff,
  0xff,0xff,0x81,0x81,0xbd,0xbd,0xa5,0xa5,
  0xa5,0xa5,0xbd,0xbd,0x81,0x81,0xff,0xff};"
     'xbm t :foreground "steel blue" :background "white")))

(defun mac-performance--scenario-inline-images (iterations)
  "Run the inline image redisplay scenario for ITERATIONS."
  (mac-performance--run-scenario
   "inline-images"
   (lambda ()
     (let ((image (mac-performance--xbm-image)))
       (dotimes (i 900)
         (insert (format "%04d " i))
         (dotimes (_ 8)
           (insert (if image
                       (propertize " " 'display image)
                     "[image]")))
         (insert "\n"))))
   #'mac-performance--scroll-window
   iterations))

(defun mac-performance--scenario-modeline-fringe (iterations)
  "Run modeline and fringe redisplay churn scenario for ITERATIONS."
  (mac-performance--run-scenario
   "modeline-fringe"
   (lambda ()
     (setq-local mode-line-format
                 '(" mac-bench " (:eval (number-to-string
                                         mac-performance--modeline-tick))))
     (dotimes (i 2000)
       (let ((start (point)))
         (insert (format "fringe line %04d\n" i))
         (put-text-property start (1+ start)
                            'display '(left-fringe right-triangle)))))
   (lambda (n)
     (dotimes (i n)
       (setq mac-performance--modeline-tick i)
       (force-mode-line-update t)
       (goto-char (point-min))
       (forward-line (mod (* i 11) 1900))
       (recenter)
       (mac-performance--redisplay)))
   iterations))

(defun mac-performance--coding-buffer-setup ()
  "Set up a source-like buffer for coding responsiveness scenarios."
  (emacs-lisp-mode)
  (mac-performance--insert-source-lines
   mac-performance-benchmark-coding-lines)
  (font-lock-ensure)
  (jit-lock-mode 1))

(defun mac-performance--scenario-coding-edit-churn (iterations)
  "Run repeated source edits that churn font-lock and redisplay."
  (mac-performance--run-scenario
   "coding-edit-churn"
   #'mac-performance--coding-buffer-setup
   (lambda (n)
     (let ((line-count (max 1 (1- mac-performance-benchmark-coding-lines))))
       (dotimes (i n)
         (goto-char (point-min))
         (forward-line (mod (* i 31) line-count))
         (end-of-line)
         (mac-performance--time-latency
          'coding-edit-command
          (lambda ()
            (insert " (+ x 1)")
            (font-lock-flush (line-beginning-position)
                             (line-end-position))
            (font-lock-ensure (line-beginning-position)
                              (line-end-position))
            (delete-region (- (point) 8) (point))))
         (when (zerop (mod i 5))
           (mac-performance--redisplay)))))
   iterations))

(defun mac-performance--scenario-coding-input-pressure (iterations)
  "Run jit-lock work while input is continuously pending.
This measures whether coding work leaves the command path quickly when the
editor should prefer fresh input over finishing all fontification."
  (mac-performance--run-scenario
   "coding-input-pressure"
   #'mac-performance--coding-buffer-setup
   (lambda (n)
     (let ((line-count (max 1 (1- mac-performance-benchmark-coding-lines))))
       (cl-letf (((symbol-function 'input-pending-p)
                  (lambda (&optional _) t)))
         (dotimes (i n)
           (goto-char (point-min))
           (forward-line (mod (* i 19) line-count))
           (let ((beg (line-beginning-position))
                 (end (min (point-max)
                           (save-excursion
                             (forward-line 20)
                             (point)))))
             (with-silent-modifications
               (put-text-property beg end 'fontified nil))
             (mac-performance--time-latency
              'jit-lock-input-pressure
              (lambda ()
                (condition-case nil
                    (jit-lock-function beg)
                  (error
                   (font-lock-ensure beg end))))))))))
   iterations))

(defun mac-performance--jsonrpc-deferred-action-available-p ()
  "Return non-nil when JSONRPC deferred-action internals are available."
  (and (featurep 'jsonrpc)
       (fboundp 'jsonrpc--call-deferred)
       (fboundp 'jsonrpc--deferred-actions)
       (fboundp 'jsonrpc--events-buffer)))

(defun mac-performance--scenario-coding-deferred-actions (iterations)
  "Run a JSONRPC deferred-action backlog under input pressure."
  (mac-performance--run-scenario
   "coding-deferred-actions"
   (lambda ()
     (fundamental-mode))
   (lambda (n)
     (if (not (mac-performance--jsonrpc-deferred-action-available-p))
         (mac-performance--record-latency 'jsonrpc-deferred-actions 0.0)
       (let* ((conn (make-instance 'jsonrpc-connection
                                   :name "mac-performance-jsonrpc"))
              (actions (jsonrpc--deferred-actions conn)))
         (dotimes (i (* 4 n))
           (let ((key (list "mac-performance" i))
                 (id i))
             (puthash
              key
              (list (lambda ()
                      id
                      (remhash key actions))
                    nil id)
              actions)))
         (cl-letf (((symbol-function 'input-pending-p)
                    (lambda (&optional _) t)))
           (while (> (hash-table-count actions) 0)
             (mac-performance--time-latency
              'jsonrpc-deferred-actions
              (lambda ()
                (jsonrpc--call-deferred conn)))))
         (when-let* ((timer (and (fboundp 'jsonrpc--deferred-actions-timer)
                                 (jsonrpc--deferred-actions-timer conn))))
           (cancel-timer timer))
         (when-let* ((buffer (jsonrpc--events-buffer conn)))
           (when (buffer-live-p buffer)
             (kill-buffer buffer))))))
   iterations))

(defconst mac-performance--scenarios
  '(("scroll-source" . mac-performance--scenario-scroll-source)
    ("typing-source" . mac-performance--scenario-typing-source)
    ("command-loop-input" . mac-performance--scenario-command-loop-input)
    ("process-output" . mac-performance--scenario-process-output)
    ("coding-edit-churn" . mac-performance--scenario-coding-edit-churn)
    ("coding-input-pressure" . mac-performance--scenario-coding-input-pressure)
    ("coding-deferred-actions" . mac-performance--scenario-coding-deferred-actions)
    ("mixed-script" . mac-performance--scenario-mixed-script)
    ("emoji" . mac-performance--scenario-emoji)
    ("inline-images" . mac-performance--scenario-inline-images)
    ("modeline-fringe" . mac-performance--scenario-modeline-fringe))
  "Mac performance benchmark scenarios in run order.")

(defun mac-performance--run-benchmark-scenarios (iterations &optional progress-file)
  "Run benchmark scenarios for ITERATIONS.
When PROGRESS-FILE is non-nil, append progress records before and after each
scenario."
  (let (results)
    (dolist (scenario mac-performance--scenarios (nreverse results))
      (let ((name (car scenario))
            (function (cdr scenario)))
        (mac-performance--record-progress
         progress-file
         (list :event 'start :scenario name :time (float-time)))
        (let ((result (funcall function iterations)))
          (mac-performance--record-progress
           progress-file
           (list :event 'finish :scenario name :time (float-time)
                 :result result))
          (push result results))))))

;;;###autoload
(defun mac-performance-run-benchmarks (&optional iterations)
  "Run macOS GUI performance benchmarks.
Optional ITERATIONS overrides `mac-performance-benchmark-iterations'.  When
called interactively with a prefix argument, use that numeric prefix."
  (interactive "P")
  (let* ((count (mac-performance--iteration-count iterations))
         (results (mac-performance--run-benchmark-scenarios count)))
    (when (called-interactively-p 'interactive)
      (with-current-buffer (get-buffer-create "*Mac Performance Benchmarks*")
        (let ((inhibit-read-only t))
          (erase-buffer)
          (dolist (result results)
            (insert (format "%-18s %8.3fs  gc=%d\n"
                            (plist-get result :name)
                            (plist-get result :seconds)
                            (plist-get result :gc-count)))
            (dolist (latency (plist-get result :latency))
              (let ((stats (cdr latency)))
                (insert (format "  latency %-24S count=%d p50=%.4fs p95=%.4fs max=%.4fs\n"
                                (car latency)
                                (plist-get stats :count)
                                (plist-get stats :p50-seconds)
                                (plist-get stats :p95-seconds)
                                (plist-get stats :max-seconds)))))
            (dolist (counter (plist-get result :counters))
              (insert (format "  %-32S %S\n" (car counter) (cdr counter)))))
          (special-mode))
        (display-buffer (current-buffer))))
    results))

(defun mac-performance--result-scenarios (results)
  "Return the scenario plist list from benchmark RESULTS."
  (cond ((and (plistp results) (plist-member results :results))
         (plist-get results :results))
        ((listp results)
         results)))

(defun mac-performance--scenario-by-name (name results)
  "Return scenario NAME from benchmark RESULTS."
  (cl-find name (mac-performance--result-scenarios results)
           :key (lambda (result) (plist-get result :name))
           :test #'equal))

(defun mac-performance--latency-p95 (scenario latency-name)
  "Return SCENARIO p95 latency for LATENCY-NAME, or nil."
  (let ((entry (alist-get latency-name (plist-get scenario :latency))))
    (plist-get entry :p95-seconds)))

(defun mac-performance--safe-ratio (numerator denominator)
  "Return NUMERATOR / DENOMINATOR, or nil when DENOMINATOR is unusable."
  (and (numberp numerator)
       (numberp denominator)
       (> denominator 0)
       (/ numerator denominator)))

;;;###autoload
(defun mac-performance-compare-results (baseline candidate)
  "Compare BASELINE and CANDIDATE benchmark result objects.
Return a plist with per-scenario elapsed-time and latency ratios.  Ratios below
1.0 mean CANDIDATE is faster than BASELINE."
  (let (rows)
    (dolist (candidate-scenario (mac-performance--result-scenarios candidate))
      (let* ((name (plist-get candidate-scenario :name))
             (baseline-scenario
              (mac-performance--scenario-by-name name baseline))
             (baseline-seconds (plist-get baseline-scenario :seconds))
             (candidate-seconds (plist-get candidate-scenario :seconds))
             (row (list :name name
                        :baseline-seconds baseline-seconds
                        :candidate-seconds candidate-seconds
                        :seconds-ratio
                        (mac-performance--safe-ratio candidate-seconds
                                                     baseline-seconds))))
        (dolist (latency '(typing-command
                           coding-edit-command
                           jit-lock-input-pressure
                           jsonrpc-deferred-actions
                           command-loop-command
                           redisplay))
          (let ((baseline-p95
                 (and baseline-scenario
                      (mac-performance--latency-p95 baseline-scenario latency)))
                (candidate-p95
                 (mac-performance--latency-p95 candidate-scenario latency)))
            (when (or baseline-p95 candidate-p95)
              (setq row
                    (append row
                            (list
                             (intern (format ":%s-p95-ratio" latency))
                             (mac-performance--safe-ratio candidate-p95
                                                          baseline-p95)))))))
        (push row rows)))
    (list :baseline-iterations (plist-get baseline :iterations)
          :candidate-iterations (plist-get candidate :iterations)
          :scenarios (nreverse rows))))

;;;###autoload
(defun mac-performance-run-benchmarks-and-exit (output-file &optional iterations
                                                           progress-file delay)
  "Schedule macOS GUI performance benchmarks, write OUTPUT-FILE, and exit.
Optional ITERATIONS overrides `mac-performance-benchmark-iterations'.
Optional PROGRESS-FILE receives one Lisp plist per scenario start and finish.
Optional DELAY overrides `mac-performance-benchmark-startup-delay'.  This entry
point is intended for GUI `--eval' startup usage, where running the benchmark
synchronously can force redisplay before the initial frame has settled."
  (unless (and (stringp output-file) (> (length output-file) 0))
    (error "Output file must be a nonempty string"))
  (let ((count (mac-performance--iteration-count iterations))
        (startup-delay (or delay mac-performance-benchmark-startup-delay)))
    (run-with-timer
     startup-delay nil
     (lambda ()
       (condition-case err
           (let ((results (mac-performance--run-benchmark-scenarios
                           count progress-file)))
             (mac-performance--write-results-file
              output-file
              (list :status 'ok :iterations count :results results))
             (kill-emacs 0))
         (error
          (ignore-errors
            (mac-performance--record-progress
             progress-file
             (list :event 'error :time (float-time)
                   :error (prin1-to-string err))))
          (ignore-errors
            (mac-performance--write-results-file
             output-file
             (list :status 'error :iterations count
                   :error (prin1-to-string err))))
          (kill-emacs 1))))))
  nil)

(provide 'mac-performance-benchmark)

